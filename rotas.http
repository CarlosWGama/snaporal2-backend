Accept: application/json
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "nome": "teste 123",
    "email": "teste@teste.com",
    "password": "123456",
    "admin": true,
    "nivel_id": 1
}

# REMOVE UM USUARIO
###
DELETE {{baseURL}}/usuarios/4
Accept: application/json
Authorization: Bearer {{adminToken}}

